# AutoClip AI Backend Environment Configuration
ENVIRONMENT=development

# YouTube Ingestion Permissions
# Set to true to permit direct YouTube stream downloading in local development:
ALLOW_YOUTUBE_DOWNLOAD=false

# YouTube Official OAuth2 / Data API Credentials (optional):
# YOUTUBE_OAUTH_TOKEN=
# YOUTUBE_API_KEY=

# STT & LLM API Keys (optional; local Whisper & heuristics used as fallback):
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ASSEMBLYAI_API_KEY=
